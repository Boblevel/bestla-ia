{
  "name": "bestla-ia-bot",
  "version": "4.0.0",
  "description": "Bestla iA, bot WhatsApp français multi-session et automatisé par RHAFF SERVICE.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bestla": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "panel": "node dist/cli.js",
    "release": "bash scripts/creer-release.sh",
    "postinstall": "bash scripts/ensure-tts.sh || echo 'Bestla TTS sera retenté automatiquement au premier usage.'; bash scripts/ensure-downloader.sh || echo 'Bestla téléchargements sera retenté automatiquement au premier usage.'"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
