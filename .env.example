# Identité
BOT_NAME=Bestla iA
BOT_SIGNATURE=RHAFF SERVICE
PREFIX=.
OWNER_NUMBERS=
PUBLIC_MODE=true

# Sessions : noms séparés par des virgules.
SESSION_NAMES=main
# qr ou pairing. Pour pairing, associer chaque session à un numéro.
AUTH_MODE=qr
SESSION_PHONES=
# Facultatif : un mode par session. Exemple : main:qr,boutique:pairing
SESSION_AUTH_MODES=
DATA_DIR=./data

# Comportement
COMMANDS_ENABLED=true
# Réagit ⏳ pendant l’exécution, puis ✅ ou ❌.
COMMAND_REACTIONS=true
MARK_READ=false
ALWAYS_ONLINE=false
REJECT_CALLS=false
WARN_LIMIT=3
MAX_MEDIA_MB=20
LOG_LEVEL=info
TIMEZONE=Africa/Ouagadougou

# API HTTP facultative
API_ENABLED=false
API_HOST=0.0.0.0
API_PORT=3000
# Obligatoire si API_ENABLED=true, 24 caractères minimum.
API_KEY=change-this-long-random-secret
API_RATE_LIMIT_PER_MINUTE=60

# Webhook facultatif pour recevoir les événements de messages.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Dossier de plugins JavaScript personnalisés (.mjs)
CUSTOM_PLUGINS_DIR=./custom-plugins

# Assistant IA facultatif.
# Option recommandée : depuis le panneau, Configuration > API IA automatique.
# Bestla utilise alors le device-flow officiel Pollinations et enregistre la clé
# privée uniquement dans .env. Aucune clé n'est publiée dans GitHub.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=700
AI_PUBLIC=false

# Pollinations - fournisseur automatique recommandé pour texte, image, retouche et vidéo.
POLLINATIONS_API_KEY=
POLLINATIONS_TEXT_MODEL=openai-fast

# Génération / modification de médias IA.
# Si le compte Pollinations manque de crédit, Bestla tente un secours image anonyme officiel.
# Pour la vidéo, Bestla peut produire un clip local de secours à partir d’une image avec FFmpeg.
MEDIA_AI_PROVIDER=pollinations
MEDIA_AI_ENABLED=false
# false = propriétaire uniquement ; true = tous les utilisateurs peuvent lancer ces commandes.
MEDIA_AI_PUBLIC=false
# Si vide, Bestla réutilise POLLINATIONS_API_KEY ou AI_API_KEY.
MEDIA_AI_API_KEY=
MEDIA_AI_IMAGE_MODEL=flux
MEDIA_AI_IMAGE_EDIT_MODEL=kontext
MEDIA_AI_IMAGE_ASPECT_RATIO=1:1
# 512px | 1K | 2K | 4K
MEDIA_AI_IMAGE_SIZE=1K
MEDIA_AI_VIDEO_MODEL=wan-fast
MEDIA_AI_VIDEO_ASPECT_RATIO=9:16
MEDIA_AI_VIDEO_TIMEOUT_SECONDS=900
