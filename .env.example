# Identité
BOT_NAME=Bestla iA
BOT_SIGNATURE=RHAFF SERVICE
PREFIX=.
OWNER_NUMBERS=
PUBLIC_MODE=true

# Sessions WhatsApp
SESSION_NAMES=main
AUTH_MODE=qr
SESSION_PHONES=
SESSION_AUTH_MODES=
DATA_DIR=./data

# Comportement
COMMANDS_ENABLED=true
COMMAND_REACTIONS=true
MARK_READ=false
ALWAYS_ONLINE=false
REJECT_CALLS=false
WARN_LIMIT=3
MAX_MEDIA_MB=20
LOG_LEVEL=info
TIMEZONE=Africa/Ouagadougou

# API HTTP facultative de Bestla (sans rapport avec Gemini)
API_ENABLED=false
API_HOST=0.0.0.0
API_PORT=3000
API_KEY=change-this-long-random-secret
API_RATE_LIMIT_PER_MINUTE=60

WEBHOOK_URL=
WEBHOOK_SECRET=
CUSTOM_PLUGINS_DIR=./custom-plugins

# IA : Gemini uniquement.
# Configure la clé depuis : bestla > Configuration > Gérer la clé Gemini
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_MAX_OUTPUT_TOKENS=700
AI_PUBLIC=false

# Médias Gemini. La même clé Gemini est utilisée.
MEDIA_AI_PROVIDER=gemini
MEDIA_AI_ENABLED=false
MEDIA_AI_PUBLIC=false
MEDIA_AI_API_KEY=
MEDIA_AI_IMAGE_MODEL=gemini-3.1-flash-image
MEDIA_AI_IMAGE_EDIT_MODEL=gemini-3.1-flash-image
MEDIA_AI_IMAGE_ASPECT_RATIO=1:1
MEDIA_AI_IMAGE_SIZE=1K
MEDIA_AI_VIDEO_MODEL=gemini-omni-flash-preview
MEDIA_AI_VIDEO_ASPECT_RATIO=9:16
MEDIA_AI_VIDEO_TIMEOUT_SECONDS=900
